{
  "name": "cube-master",
  "version": "0.1.0",
  "private": true,
  "description": "Rubik's Cube companion app — Solver, Coach, and Timer modes",
  "keywords": [
    "monorepo",
    "turbo",
    "rubiks-cube",
    "react",
    "hono",
    "typescript"
  ],
  "author": "Titux Metal",
  "license": "MIT",
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "start": "turbo run start",
    "docker:build": "scripts/docker-build.sh web",
    "docker:push": "turbo run docker:push",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:watch": "turbo run test:watch",
    "lint": "turbo run lint",
    "lint:check": "turbo run lint:check",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "bun pm pack --dry-run",
    "clean": "turbo run clean && rm -rf .turbo",
    "reset": "bun run clean && rm -rf node_modules bun.lock && bun install",
    "prepare": "husky",
    "commit": "cz",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build --filter=./packages/* && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@types/node": "^24.12.0",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.39.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "turbo": "^2.9.3",
    "typescript": "^6.0.2"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "lint-staged": {
    "apps/web/**/*.{ts,tsx}": [
      "bash -c 'cd apps/web && eslint --fix \"$@\"' --",
      "prettier --write"
    ],
    "packages/cube-engine/**/*.ts": [
      "bash -c 'cd packages/cube-engine && eslint --fix \"$@\"' --",
      "prettier --write"
    ],
    "packages/eslint-config/**/*.{ts,js,mjs}": [
      "prettier --write"
    ],
    "**/*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
