{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(bun install)",
      "Bash(bun add:*)",
      "Bash(bun run build)",
      "Bash(bun run dev:*)",
      "Bash(bun run test:*)",
      "Bash(bun run typecheck)",
      "Bash(bun run lint:check)",
      "Bash(bun run format:check)",
      "Bash(bun run clean)",
      "Bash(turbo run:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -f:*)",
      "Bash(sudo:*)",
      "Bash(curl * | sh:*)",
      "Bash(wget * | sh:*)"
    ]
  },
  "extraKnownMarketplaces": {
    "heart-of-gold-toolkit": {
      "source": {
        "source": "github",
        "repo": "ondrej-svec/heart-of-gold-toolkit"
      }
    },
    "cc-lab": {
      "source": {
        "source": "github",
        "repo": "ondrej-svec/claude-code-lab"
      }
    },
    "compound-engineering-plugin": {
      "source": {
        "source": "github",
        "repo": "EveryInc/compound-engineering-plugin"
      }
    }
  },
  "enabledPlugins": {
    "deep-thought@heart-of-gold-toolkit": true,
    "marvin@heart-of-gold-toolkit": true,
    "babel-fish@heart-of-gold-toolkit": true,
    "cc-lab@cc-lab": true,
    "compound-engineering@compound-engineering-plugin": true
  }
}
