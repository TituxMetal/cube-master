---
import '~/styles/globals.css'

const { title } = Astro.props
---

<!doctype html>
<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width' />
    <link rel='icon' type='image/svg+xml' href='/favicon.svg' />
    <meta name='generator' content={Astro.generator} />
    <title>CubeMaster {title && `| ${title}`}</title>
  </head>
  <body class='min-h-screen'>
    <header class='navbar bg-base-200 shadow-sm'>
      <nav class='mx-auto flex w-full max-w-5xl items-center gap-4'>
        <a href='/' class='text-xl font-semibold'>CubeMaster</a>
        <a href='/demo' class='btn btn-ghost btn-sm'>Demo</a>
      </nav>
    </header>
    <main class='mx-auto flex w-full max-w-5xl flex-1 flex-col py-6'>
      <slot />
    </main>
    <footer class='footer footer-center bg-base-200 text-base-content/70 p-4'>
      <p>{new Date().getFullYear()} CubeMaster</p>
    </footer>
  </body>
</html>
