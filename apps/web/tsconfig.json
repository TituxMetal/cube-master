{
  "extends": "@packages/ts-config/web",
  "compilerOptions": {
    "outDir": "./dist",
    "types": ["bun", "vite/client"],
    "paths": {
      "~/*": ["./src/*"],
      "~ui/*": ["./src/components/ui/*"],
      "~features/*": ["./src/features/*"]
    }
  },
  "include": ["src/**/*", "*.ts", "*.tsx", "**/*.d.ts", "**/*.spec.tsx"],
  "exclude": ["node_modules", "dist", "coverage", ".turbo"]
}
