# Stage 1: Install dependencies and build the application
FROM oven/bun:1.3.10-alpine AS build

WORKDIR /app

COPY package.json bun.lock ./
COPY apps/web/ ./apps/web/
COPY packages/ ./packages/

# Install all dependencies
RUN bun install --filter @app/web --frozen-lockfile

# Build the application
RUN bun run --filter @app/web build

# Stage 2: Production
FROM oven/bun:1.3.10-alpine AS production

# Create non-root user and group
RUN addgroup -S appgroup && adduser -S appuser -G appgroup

WORKDIR /app

# Copy minimal files for production
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/package.json /app/bun.lock ./
COPY --from=build /app/apps/web/package.json ./apps/web/
COPY --from=build /app/packages ./packages/

# Install only production dependencies
RUN bun install --filter @app/web --frozen-lockfile --production

# Copy built client assets and server source
COPY --from=build /app/apps/web/dist ./apps/web/dist
COPY --from=build /app/apps/web/src/server.ts ./apps/web/src/server.ts

# Set environment variables for production runtime
ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=3000

# Change ownership of the app directory
RUN chown -R appuser:appgroup /app

EXPOSE ${PORT}

USER appuser

# Start the Hono server
CMD ["bun", "run", "--cwd", "apps/web", "start"]
